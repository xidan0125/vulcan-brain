# vulcan_libs/bicameral_types.py
"""
Vulcan Brain V6.0 - 1.5 脑架构类型定义
Pydantic 强类型 + TypedDict 状态
"""

from typing import Literal, List, Optional, Annotated
from pydantic import BaseModel, Field
from typing_extensions import TypedDict
from langgraph.graph.message import add_messages
from langchain_core.messages import BaseMessage


# ============ CEO Action ============

class DelegationSpec(BaseModel):
    """委派任务规范"""
    objective: str = Field(..., description="要完成什么")
    context: str = Field(default="", description="背景/上下文")
    constraints: List[str] = Field(default_factory=list, description="约束条件")
    expected_output: str = Field(default="执行结果", description="期望输出形式")


class CEOAction(BaseModel):
    """CEO 决策输出 - 强制 JSON 格式"""
    action: Literal["direct_answer", "need_code"]
    answer: Optional[str] = None          # direct_answer 时使用
    delegation: Optional[DelegationSpec] = None  # need_code 时使用
    reasoning: Optional[str] = None       # 内部推理（调试用）


# ============ CTO Task & Result ============

class CTOTask(BaseModel):
    """CTO 任务输入"""
    objective: str
    context: str = ""
    constraints: List[str] = Field(default_factory=list)
    expected_output: str = "执行结果"
    
    def to_prompt(self) -> str:
        """转换为 prompt"""
        constraints_str = ', '.join(self.constraints) if self.constraints else "无"
        return f"""任务目标: {self.objective}
背景: {self.context}
约束: {constraints_str}
期望输出: {self.expected_output}"""


class CTOResult(BaseModel):
    """CTO 执行结果"""
    success: bool
    result: Optional[str] = None   # 成功时：执行结果
    error: Optional[str] = None    # 失败时：错误信息
    code: Optional[str] = None     # 实际执行的代码


# ============ Synth Result ============

class SynthResult(BaseModel):
    """综合分析结果"""
    core_facts: List[str] = Field(default_factory=list, description="关键事实")
    analysis: str = Field(default="", description="分析")
    conclusion: str = Field(..., description="结论")
    confidence: float = Field(default=0.8, ge=0.0, le=1.0, description="置信度")
    
    def to_answer(self) -> str:
        """转换为自然语言回答"""
        facts = '\n'.join(f"- {f}" for f in self.core_facts) if self.core_facts else ""
        parts = []
        if self.conclusion:
            parts.append(f"**结论**: {self.conclusion}")
        if facts:
            parts.append(f"\n**关键事实**:\n{facts}")
        if self.analysis:
            parts.append(f"\n**分析**: {self.analysis}")
        return '\n'.join(parts)


# ============ Graph State ============

class GraphState(TypedDict, total=False):
    """LangGraph 状态"""
    # 基础
    run_id: str
    user_input: str
    messages: Annotated[List[BaseMessage], add_messages]
    
    # CEO 输出
    ceo_action: dict  # CEOAction.model_dump()
    
    # CTO 输入输出
    cto_task: dict    # CTOTask.model_dump()
    cto_result: dict  # CTOResult.model_dump()
    
    # Synth 输出
    synth_result: dict  # SynthResult.model_dump()
    
    # 最终回答
    final_answer: str
    
    # 控制
    thread_id: str
    created_at: str
    retry_count: int
    last_error: str


# ============ 辅助函数 ============

def parse_ceo_action(json_str: str) -> CEOAction:
    """解析 CEO JSON 输出"""
    return CEOAction.model_validate_json(json_str)


def parse_cto_result(data: dict) -> CTOResult:
    """解析 CTO 结果"""
    return CTOResult.model_validate(data)


def parse_synth_result(json_str: str) -> SynthResult:
    """解析 Synth JSON 输出"""
    return SynthResult.model_validate_json(json_str)


if __name__ == "__main__":
    # 测试
    action = CEOAction(
        action="need_code",
        delegation=DelegationSpec(
            objective="搜索特斯拉2024财报",
            constraints=["使用 web_search"]
        ),
        reasoning="用户需要最新财报数据"
    )
    print("CEOAction:", action.model_dump_json(indent=2))
    
    result = CTOResult(success=True, result="特斯拉Q3营收251.8亿美元")
    print("CTOResult:", result.model_dump_json(indent=2))
