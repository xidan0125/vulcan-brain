# bicameral_graph.py - V6.0 1.5 Brain Architecture
"""
Vulcan Brain V6.0 - 1.5 脑架构

架构简化：
- SingleBrain (Qwen3 Thinking): CEO + Synth 合一
- CodeTool (Qwen2.5 Coder): 仅作为工具被调用

状态图：
User → ceo_node → router → direct_answer → final_node → END
                        └→ need_code → cto_node → synth_node → END
"""

import json
import ast
import logging
from datetime import datetime
from typing import Dict, Any, Literal

from langgraph.graph import StateGraph, START, END
from langgraph.checkpoint.postgres.aio import AsyncPostgresSaver

from langchain_core.messages import HumanMessage, AIMessage

import httpx

# 类型定义
from vulcan_libs.bicameral_types import (
    GraphState, CEOAction, DelegationSpec,
    CTOTask, CTOResult, SynthResult,
    parse_ceo_action, parse_synth_result
)

# 工具
from vulcan_libs.ceo_soul import get_ceo_soul
from vulcan_libs.cto_executor import get_cto_executor, TaskSpec, ExecutionResult
from vulcan_libs.stream_filter import OptimizedStreamingThinkFilter

# ============ 配置 ============

POSTGRES_URI = "postgresql://admin:vulcan%402025@localhost:5432/vulcan_brain"

THINKING_MODEL = {
    "base_url": "http://localhost:11434",
    "model": "qwen3:30b-a3b",
    "timeout": 120.0
}

CODER_MODEL = {
    "base_url": "http://localhost:11434",
    "model": "qwen2.5-coder:32b",  # 或其他 coder 模型
    "timeout": 60.0
}

logger = logging.getLogger("bicameral_v6")


# ============ CEO Node (SingleBrain 决策) ============

CEO_SYSTEM_PROMPT = """你是决策脑。根据用户输入，决定：
1) 直接回答 (direct_answer)：简单问题、闲聊、时间日期、通用知识
2) 需要代码执行 (need_code)：搜索最新信息、计算、数据分析

你必须输出一个 JSON 对象，严格符合：
{
  "action": "direct_answer" | "need_code",
  "answer": "直接回答内容" | null,
  "delegation": {
    "objective": "任务目标",
    "context": "背景",
    "constraints": ["使用 web_search"],
    "expected_output": "期望输出"
  } | null,
  "reasoning": "推理过程" | null
}

注意：
- direct_answer 时，answer 必须有值，delegation 为 null
- need_code 时，delegation 必须有值，answer 为 null
- 只输出 JSON，不要其他文字
"""


async def ceo_node(state: GraphState) -> Dict[str, Any]:
    """CEO 节点 - 决策：直接回答 or 需要代码"""
    user_input = state.get("user_input", "")
    if not user_input:
        messages = state.get("messages", [])
        if messages:
            user_input = messages[-1].content if hasattr(messages[-1], 'content') else str(messages[-1])
    
    print(f"\n🧠 [CEO] 分析: {user_input[:50]}...")
    
    # 获取环境感知
    soul = get_ceo_soul()
    perception = soul.get_perception_context()
    
    system_prompt = f"""{perception}

{CEO_SYSTEM_PROMPT}"""
    
    async with httpx.AsyncClient(timeout=THINKING_MODEL["timeout"]) as client:
        try:
            resp = await client.post(
                f"{THINKING_MODEL['base_url']}/api/chat",
                json={
                    "model": THINKING_MODEL["model"],
                    "messages": [
                        {"role": "system", "content": system_prompt},
                        {"role": "user", "content": user_input}
                    ],
                    "stream": False,
                    "format": "json",  # 强制 JSON
                    "options": {"temperature": 0.2}
                }
            )
            data = resp.json()
            raw_json = data.get("message", {}).get("content", "{}")
            
        except Exception as e:
            print(f"❌ [CEO] 调用失败: {e}")
            return {
                "ceo_action": CEOAction(
                    action="direct_answer",
                    answer=f"抱歉，系统错误: {e}"
                ).model_dump(),
                "final_answer": f"系统错误: {e}"
            }
    
    # 解析 JSON
    try:
        action = parse_ceo_action(raw_json)
        print(f"✓ [CEO] 决策: {action.action}")
        
        return {
            "user_input": user_input,
            "ceo_action": action.model_dump()
        }
        
    except Exception as e:
        print(f"⚠️ [CEO] JSON 解析失败: {e}, 降级为直接回答")
        # 降级：清洗后作为直接回答
        filter = OptimizedStreamingThinkFilter()
        clean = ""
        for (evt, content) in filter.process_chunk(raw_json):
            if evt == 'token':
                clean += content
        for (evt, content) in filter.flush():
            if evt == 'token':
                clean += content
        
        return {
            "user_input": user_input,
            "ceo_action": CEOAction(
                action="direct_answer",
                answer=clean or raw_json
            ).model_dump()
        }


# ============ Router ============

def router_decision(state: GraphState) -> Literal["direct_answer", "need_code"]:
    """路由决策"""
    ceo_action = state.get("ceo_action", {})
    action = ceo_action.get("action", "direct_answer")
    return action


# ============ Final Node (直接回答路径) ============

def final_node(state: GraphState) -> Dict[str, Any]:
    """直接回答 - 直接输出"""
    ceo_action = state.get("ceo_action", {})
    answer = ceo_action.get("answer", "")
    
    print(f"💬 [Final] 直接回答: {answer[:50]}...")
    
    return {
        "final_answer": answer,
        "messages": [AIMessage(content=answer)]
    }


# ============ CTO Node (CodeTool) ============

async def cto_node(state: GraphState) -> Dict[str, Any]:
    """CTO 节点 - 代码执行工具"""
    ceo_action = state.get("ceo_action", {})
    delegation = ceo_action.get("delegation", {})
    
    if not delegation:
        return {
            "cto_result": CTOResult(
                success=False,
                error="没有委派信息"
            ).model_dump()
        }
    
    print(f"\n⚙️ [CTO] 执行: {delegation.get('objective', '')[:50]}...")
    
    # 转换为 TaskSpec
    task = TaskSpec(
        task_id=f"task_{datetime.now().strftime('%H%M%S')}",
        objective=delegation.get("objective", ""),
        context=delegation.get("context", ""),
        constraints=delegation.get("constraints", []),
        expected_output=delegation.get("expected_output", "执行结果")
    )
    
    # 使用现有 CTO executor
    executor = get_cto_executor()
    result: ExecutionResult = await executor.execute(task)
    
    cto_result = CTOResult(
        success=result.success,
        result=result.output if result.success else None,
        error=result.error if not result.success else None,
        code=result.code
    )
    
    if result.success:
        print(f"✅ [CTO] 成功: {result.output[:50]}...")
    else:
        print(f"❌ [CTO] 失败: {result.error}")
    
    return {
        "cto_task": task.__dict__,
        "cto_result": cto_result.model_dump()
    }


# ============ Synth Node ============

SYNTH_SYSTEM_PROMPT = """你是分析模块。根据用户问题和执行结果，输出结构化分析。

你必须输出一个 JSON：
{
  "core_facts": ["关键事实1", "关键事实2"],
  "analysis": "深度分析",
  "conclusion": "简洁结论",
  "confidence": 0.8
}

要求：
- core_facts: 直接回答问题的关键数据
- analysis: 数据背后的洞察
- conclusion: 1-2句话总结
- confidence: 0.0-1.0 的置信度

不要输出 JSON 以外的内容。
"""


async def synth_node(state: GraphState) -> Dict[str, Any]:
    """Synth 节点 - 综合分析"""
    user_input = state.get("user_input", "")
    cto_result = state.get("cto_result", {})
    
    print(f"\n🎯 [Synth] 综合分析...")
    
    if not cto_result.get("success"):
        # CTO 失败，返回错误
        error = cto_result.get("error", "未知错误")
        return {
            "final_answer": f"执行失败: {error}",
            "messages": [AIMessage(content=f"执行失败: {error}")]
        }
    
    result_text = cto_result.get("result", "")
    
    content = f"""用户问题: {user_input}

执行结果:
{result_text}
"""
    
    async with httpx.AsyncClient(timeout=THINKING_MODEL["timeout"]) as client:
        try:
            resp = await client.post(
                f"{THINKING_MODEL['base_url']}/api/chat",
                json={
                    "model": THINKING_MODEL["model"],
                    "messages": [
                        {"role": "system", "content": SYNTH_SYSTEM_PROMPT},
                        {"role": "user", "content": content}
                    ],
                    "stream": False,
                    "format": "json",
                    "options": {"temperature": 0.2}
                }
            )
            data = resp.json()
            raw_json = data.get("message", {}).get("content", "{}")
            
            synth = parse_synth_result(raw_json)
            answer = synth.to_answer()
            
            print(f"✓ [Synth] 完成")
            
            return {
                "synth_result": synth.model_dump(),
                "final_answer": answer,
                "messages": [AIMessage(content=answer)]
            }
            
        except Exception as e:
            print(f"⚠️ [Synth] 解析失败，降级返回原始结果")
            # 降级：直接返回 CTO 结果
            return {
                "final_answer": result_text,
                "messages": [AIMessage(content=result_text)]
            }


# ============ 构建图 ============

def create_bicameral_graph() -> StateGraph:
    """创建 1.5 脑状态图"""
    graph = StateGraph(GraphState)
    
    # 节点
    graph.add_node("ceo", ceo_node)
    graph.add_node("cto", cto_node)
    graph.add_node("synth", synth_node)
    graph.add_node("final", final_node)
    
    # 入口
    graph.add_edge(START, "ceo")
    
    # CEO 决策分支
    graph.add_conditional_edges(
        "ceo",
        router_decision,
        {
            "direct_answer": "final",
            "need_code": "cto"
        }
    )
    
    # CTO → Synth → END
    graph.add_edge("cto", "synth")
    graph.add_edge("synth", END)
    
    # Final → END
    graph.add_edge("final", END)
    
    return graph


# ============ Runner ============

class BicameralRunner:
    """1.5 脑运行器"""
    
    def __init__(self, db_uri: str = POSTGRES_URI):
        self.db_uri = db_uri
        self._workflow = None
    
    def _get_workflow(self):
        if self._workflow is None:
            self._workflow = create_bicameral_graph()
        return self._workflow
    
    async def run(
        self,
        user_message: str,
        thread_id: str = "default",
        max_steps: int = 10,
    ) -> str:
        workflow = self._get_workflow()
        
        async with AsyncPostgresSaver.from_conn_string(self.db_uri) as checkpointer:
            app = workflow.compile(checkpointer=checkpointer)
            
            initial_state = {
                "user_input": user_message,
                "messages": [HumanMessage(content=user_message)],
                "ceo_action": {},
                "cto_task": {},
                "cto_result": {},
                "synth_result": {},
                "final_answer": "",
                "thread_id": thread_id,
                "created_at": datetime.now().isoformat(),
                "retry_count": 0,
                "last_error": ""
            }
            
            config = {"configurable": {"thread_id": thread_id}}
            final_state = await app.ainvoke(initial_state, config)
            return final_state.get("final_answer", "No answer")
    
    async def run_stream(
        self,
        user_message: str,
        thread_id: str = "default",
        max_steps: int = 10,
    ):
        """流式执行 - 只输出最终结果"""
        workflow = self._get_workflow()
        
        async with AsyncPostgresSaver.from_conn_string(self.db_uri) as checkpointer:
            app = workflow.compile(checkpointer=checkpointer)
            
            initial_state = {
                "user_input": user_message,
                "messages": [HumanMessage(content=user_message)],
                "ceo_action": {},
                "cto_task": {},
                "cto_result": {},
                "synth_result": {},
                "final_answer": "",
                "thread_id": thread_id,
                "created_at": datetime.now().isoformat(),
                "retry_count": 0,
                "last_error": ""
            }
            
            config = {"configurable": {"thread_id": thread_id}}
            emitted = set()
            
            async for event in app.astream_events(initial_state, config, version="v2"):
                event_type = event.get("event")
                
                if event_type == "on_chain_start":
                    yield {"type": "node_start", "node": event.get("name", "")}
                
                elif event_type == "on_chain_end":
                    node = event.get("name", "")
                    output = event.get("data", {}).get("output", {})
                    
                    # 只输出最终答案
                    if isinstance(output, dict):
                        answer = output.get("final_answer", "")
                        if answer and answer not in emitted:
                            emitted.add(answer)
                            yield {"type": "token", "content": answer}
                    
                    yield {"type": "node_end", "node": node}


# ============ 便捷函数 ============

_runner_cache = None

def get_bicameral_runner() -> BicameralRunner:
    global _runner_cache
    if _runner_cache is None:
        _runner_cache = BicameralRunner()
    return _runner_cache


# ============ 测试 ============

async def test():
    runner = BicameralRunner()
    
    print("\n" + "="*50)
    print("测试 1: 直接回答")
    result = await runner.run("现在几点了？")
    print(f"结果: {result}")
    
    print("\n" + "="*50)
    print("测试 2: 需要搜索")
    result = await runner.run("特斯拉2024年Q3交付量多少？")
    print(f"结果: {result}")


if __name__ == "__main__":
    import asyncio
    asyncio.run(test())
