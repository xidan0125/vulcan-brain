# bicameral_graph.py - V5.0 Enterprise Bicameral Architecture
"""
Vulcan Brain - LangGraph 双脑编排系统

架构设计：
1. StateGraph: 显式图拓扑，可视化调试
2. Checkpointer: PostgreSQL 状态持久化，断点续传
3. CEO Node: Ollama 思考脑 (qwen3:30b-a3b)
4. CTO Node: SGLang 执行脑 (Qwen2.5-Coder-32B-AWQ)
5. Shadow Worker: 并行预加载 (RAG/数据)

企业级特性：
- 容错重试：节点失败自动恢复
- Human-in-loop：关键决策人工确认
- Time Travel：回滚到任意历史状态
- PostgreSQL：生产级状态存储
"""

import re
import json
import asyncio
import traceback
from datetime import datetime
from typing import TypedDict, Annotated, Literal, Optional, List, Dict, Any, Sequence
from typing_extensions import TypedDict

from langgraph.graph import StateGraph, START, END
from langgraph.graph.message import add_messages
from langgraph.checkpoint.postgres.aio import AsyncPostgresSaver

from langchain_core.messages import (
    BaseMessage,
    HumanMessage,
    AIMessage,
    SystemMessage,
    ToolMessage
)

# 本地模块
import httpx

# ============ 配置 ============

# PostgreSQL 连接
POSTGRES_URI = "postgres://vulcan:vulcan123@localhost:5432/vulcan_brain"

CEO_CONFIG = {
    "base_url": "http://localhost:11434",
    "model": "qwen3:30b-a3b",
    "timeout": 120.0
}

CTO_CONFIG = {
    "base_url": "http://localhost:30000",
    "model": "Qwen/Qwen2.5-Coder-32B-Instruct-AWQ",
    "timeout": 120.0
}

# 代码块正则
CODE_BLOCK_REGEX = re.compile(r"```python\n(.*?)\n```", re.DOTALL)


# ============ State 定义 ============

class BicameralState(TypedDict):
    """双脑系统状态 (Type-Safe)"""
    # 消息历史 (自动合并)
    messages: Annotated[Sequence[BaseMessage], add_messages]

    # CEO 分析结果
    user_intent: str  # 用户意图分类
    task_plan: str    # 任务规划
    needs_code: bool  # 是否需要代码执行

    # CTO 执行结果
    code_generated: str     # 生成的代码
    execution_result: str   # 执行结果
    execution_success: bool # 执行是否成功

    # 流程控制
    current_step: int       # 当前步骤
    max_steps: int          # 最大步骤
    final_answer: str       # 最终回答

    # 元信息
    thread_id: str          # 会话 ID
    created_at: str         # 创建时间


# ============ 工具函数 ============

async def call_ollama(
    messages: List[Dict[str, str]],
    model: str = CEO_CONFIG["model"],
    base_url: str = CEO_CONFIG["base_url"],
    timeout: float = CEO_CONFIG["timeout"]
) -> str:
    """调用 Ollama API (CEO 思考脑)"""
    async with httpx.AsyncClient(timeout=timeout) as client:
        response = await client.post(
            f"{base_url}/api/chat",
            json={
                "model": model,
                "messages": messages,
                "stream": False
            }
        )
        response.raise_for_status()
        data = response.json()
        content = data.get("message", {}).get("content", "")

        # 清理 think 标签
        if "</think>" in content:
            content = content.split("</think>")[-1].strip()

        return content


async def call_sglang(
    prompt: str,
    system_prompt: Optional[str] = None,
    model: str = CTO_CONFIG["model"],
    base_url: str = CTO_CONFIG["base_url"],
    timeout: float = CTO_CONFIG["timeout"],
    max_tokens: int = 4096,
    temperature: float = 0.0
) -> str:
    """调用 SGLang API (CTO 执行脑)"""
    messages = []
    if system_prompt:
        messages.append({"role": "system", "content": system_prompt})
    messages.append({"role": "user", "content": prompt})

    async with httpx.AsyncClient(timeout=timeout) as client:
        response = await client.post(
            f"{base_url}/v1/chat/completions",
            json={
                "model": model,
                "messages": messages,
                "max_tokens": max_tokens,
                "temperature": temperature
            }
        )
        response.raise_for_status()
        data = response.json()
        return data["choices"][0]["message"]["content"]


def execute_code(code: str, env: Optional[Dict] = None) -> tuple[str, bool]:
    """安全执行 Python 代码"""
    import io
    import sys

    if env is None:
        env = {
            '__builtins__': __builtins__,
            'print': print,
            'json': __import__('json'),
            'datetime': datetime,
        }

    old_stdout = sys.stdout
    sys.stdout = buffer = io.StringIO()

    success = True
    try:
        exec(code, env)
        output = buffer.getvalue()
        if not output:
            output = "(No output)"
    except Exception as e:
        output = f"Error: {type(e).__name__}: {str(e)}\n{traceback.format_exc()}"
        success = False
    finally:
        sys.stdout = old_stdout

    return output, success


# ============ Graph Nodes ============

async def ceo_node(state: BicameralState) -> Dict[str, Any]:
    """
    CEO Node: 战略思考脑

    职责：
    1. 分析用户意图
    2. 判断是否需要代码
    3. 规划执行步骤
    4. 生成最终回答 (如果不需要代码)
    """
    print(f"🧠 [CEO] Step {state.get('current_step', 1)}: 分析中...")

    # 构建消息历史
    messages = []
    for msg in state.get("messages", []):
        if isinstance(msg, HumanMessage):
            messages.append({"role": "user", "content": msg.content})
        elif isinstance(msg, AIMessage):
            messages.append({"role": "assistant", "content": msg.content})
        elif isinstance(msg, SystemMessage):
            messages.append({"role": "system", "content": msg.content})

    # CEO System Prompt
    system_prompt = f"""你是 Vulcan Brain CEO - 战略决策脑。

【当前时间】{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}

【你的职责】
1. 深度理解用户意图
2. 判断任务是否需要代码执行
3. 如需代码，编写 Python 代码（使用 ```python ... ```）
4. 如不需要，直接给出精准回答

【工作原则】
- 简洁优于啰嗦
- 代码必须使用 print() 输出关键结果
- 时间/日期问题直接回答，不要写代码
- 思考过程用 <think>...</think> 包裹
"""

    # 插入 system prompt
    if messages and messages[0].get("role") != "system":
        messages.insert(0, {"role": "system", "content": system_prompt})

    # 调用 CEO
    response = await call_ollama(messages)

    # 分析响应
    has_code = bool(CODE_BLOCK_REGEX.search(response))

    # 更新状态
    updates = {
        "messages": [AIMessage(content=response)],
        "needs_code": has_code,
        "current_step": state.get("current_step", 1) + 1,
    }

    if has_code:
        code_match = CODE_BLOCK_REGEX.search(response)
        updates["code_generated"] = code_match.group(1).strip() if code_match else ""
        updates["task_plan"] = "CEO 生成代码，转交 CTO 执行"
        print(f"💡 [CEO] 检测到代码，转交 CTO")
    else:
        updates["final_answer"] = response
        updates["task_plan"] = "直接回答，无需代码"
        print(f"✅ [CEO] 直接回答完成")

    return updates


async def cto_node(state: BicameralState) -> Dict[str, Any]:
    """
    CTO Node: 技术执行脑

    职责：
    1. 执行 CEO 生成的代码
    2. 捕获输出结果
    3. 处理执行错误
    """
    print(f"⚡ [CTO] 执行代码...")

    code = state.get("code_generated", "")
    if not code:
        return {
            "execution_result": "No code to execute",
            "execution_success": False
        }

    # 执行代码
    result, success = execute_code(code)

    print(f"{'✅' if success else '❌'} [CTO] 执行{'成功' if success else '失败'}")
    print(f"📤 Output: {result[:200]}...")

    # 将执行结果加入消息历史
    result_message = f"代码执行结果:\n{result}"

    return {
        "messages": [HumanMessage(content=result_message)],
        "execution_result": result,
        "execution_success": success
    }


async def synthesizer_node(state: BicameralState) -> Dict[str, Any]:
    """
    Synthesizer Node: 结果整合

    职责：
    1. 根据 CTO 执行结果生成最终回答
    2. 处理执行失败的情况
    """
    print(f"📝 [Synthesizer] 整合结果...")

    execution_result = state.get("execution_result", "")
    execution_success = state.get("execution_success", False)

    if execution_success:
        # 让 CEO 基于结果生成最终回答
        messages = []
        for msg in state.get("messages", []):
            if isinstance(msg, HumanMessage):
                messages.append({"role": "user", "content": msg.content})
            elif isinstance(msg, AIMessage):
                messages.append({"role": "assistant", "content": msg.content})

        # 添加综合指令
        messages.append({
            "role": "user",
            "content": f"代码执行成功，请根据以上结果给出简洁的最终回答。"
        })

        final_answer = await call_ollama(messages)

        return {
            "messages": [AIMessage(content=final_answer)],
            "final_answer": final_answer
        }
    else:
        # 执行失败，报告错误
        error_msg = f"代码执行失败:\n{execution_result}"
        return {
            "messages": [AIMessage(content=error_msg)],
            "final_answer": error_msg
        }


# ============ Router Functions ============

def should_execute_code(state: BicameralState) -> Literal["cto", "end"]:
    """路由决策：是否需要执行代码"""
    needs_code = state.get("needs_code", False)
    current_step = state.get("current_step", 1)
    max_steps = state.get("max_steps", 10)

    if current_step > max_steps:
        print(f"⚠️ [Router] 达到最大步骤数 {max_steps}")
        return "end"

    if needs_code:
        print(f"🔀 [Router] -> CTO (执行代码)")
        return "cto"
    else:
        print(f"🔀 [Router] -> END (直接回答)")
        return "end"


def should_continue_or_synthesize(state: BicameralState) -> Literal["synthesize", "ceo"]:
    """路由决策：继续迭代还是整合结果"""
    execution_success = state.get("execution_success", False)
    current_step = state.get("current_step", 1)
    max_steps = state.get("max_steps", 10)

    if current_step > max_steps:
        return "synthesize"

    if execution_success:
        return "synthesize"
    else:
        # 执行失败，让 CEO 重新思考
        print(f"🔄 [Router] 执行失败，返回 CEO 重试")
        return "ceo"


# ============ Build Graph ============

def create_bicameral_graph() -> StateGraph:
    """构建双脑 StateGraph"""

    # 创建图
    workflow = StateGraph(BicameralState)

    # 添加节点
    workflow.add_node("ceo", ceo_node)
    workflow.add_node("cto", cto_node)
    workflow.add_node("synthesizer", synthesizer_node)

    # 定义边
    workflow.add_edge(START, "ceo")

    # CEO 之后的条件路由
    workflow.add_conditional_edges(
        "ceo",
        should_execute_code,
        {
            "cto": "cto",
            "end": END
        }
    )

    # CTO 之后的条件路由
    workflow.add_conditional_edges(
        "cto",
        should_continue_or_synthesize,
        {
            "synthesize": "synthesizer",
            "ceo": "ceo"
        }
    )

    # Synthesizer -> END
    workflow.add_edge("synthesizer", END)

    return workflow


# ============ 运行接口 ============

class BicameralRunner:
    """双脑运行器 - 封装 LangGraph 调用 (PostgreSQL 持久化)"""

    def __init__(self, db_uri: str = POSTGRES_URI):
        self.db_uri = db_uri
        self._workflow = None
        self._setup_done = False
    
    def _get_workflow(self) -> StateGraph:
        """获取工作流（惰性创建）"""
        if self._workflow is None:
            self._workflow = create_bicameral_graph()
        return self._workflow

    async def run(
        self,
        user_message: str,
        thread_id: str = "default",
        max_steps: int = 10
    ) -> str:
        """
        执行用户请求

        Args:
            user_message: 用户消息
            thread_id: 会话 ID (用于状态持久化)
            max_steps: 最大执行步骤

        Returns:
            最终回答
        """
        workflow = self._get_workflow()
        
        # 使用 async with 正确管理 PostgreSQL checkpointer 生命周期
        async with AsyncPostgresSaver.from_conn_string(self.db_uri) as checkpointer:
            # 首次运行时初始化表结构
            if not self._setup_done:
                await checkpointer.setup()
                self._setup_done = True
                print("✅ [PostgreSQL] Checkpoint 表已初始化")
            
            app = workflow.compile(checkpointer=checkpointer)
            
            # 初始状态
            initial_state = {
                "messages": [HumanMessage(content=user_message)],
                "user_intent": "",
                "task_plan": "",
                "needs_code": False,
                "code_generated": "",
                "execution_result": "",
                "execution_success": False,
                "current_step": 1,
                "max_steps": max_steps,
                "final_answer": "",
                "thread_id": thread_id,
                "created_at": datetime.now().isoformat()
            }

            # 配置
            config = {"configurable": {"thread_id": thread_id}}

            # 执行图
            final_state = await app.ainvoke(initial_state, config)

            return final_state.get("final_answer", "No answer generated")

    async def run_stream(
        self,
        user_message: str,
        thread_id: str = "default",
        max_steps: int = 10
    ):
        """
        流式执行用户请求

        Yields:
            Dict with event type and content
        """
        workflow = self._get_workflow()
        
        async with AsyncPostgresSaver.from_conn_string(self.db_uri) as checkpointer:
            if not self._setup_done:
                await checkpointer.setup()
                self._setup_done = True
            
            app = workflow.compile(checkpointer=checkpointer)
            
            initial_state = {
                "messages": [HumanMessage(content=user_message)],
                "user_intent": "",
                "task_plan": "",
                "needs_code": False,
                "code_generated": "",
                "execution_result": "",
                "execution_success": False,
                "current_step": 1,
                "max_steps": max_steps,
                "final_answer": "",
                "thread_id": thread_id,
                "created_at": datetime.now().isoformat()
            }

            config = {"configurable": {"thread_id": thread_id}}

            # 流式执行
            async for event in app.astream_events(initial_state, config, version="v2"):
                event_type = event.get("event")

                if event_type == "on_chain_start":
                    node_name = event.get("name", "")
                    yield {"type": "node_start", "node": node_name}

                elif event_type == "on_chain_end":
                    node_name = event.get("name", "")
                    output = event.get("data", {}).get("output", {})
                    yield {"type": "node_end", "node": node_name, "output": output}

                elif event_type == "on_chat_model_stream":
                    content = event.get("data", {}).get("chunk", {}).get("content", "")
                    if content:
                        yield {"type": "token", "content": content}

    async def get_history(self, thread_id: str) -> List[Dict]:
        """获取会话历史"""
        workflow = self._get_workflow()
        
        async with AsyncPostgresSaver.from_conn_string(self.db_uri) as checkpointer:
            app = workflow.compile(checkpointer=checkpointer)
            config = {"configurable": {"thread_id": thread_id}}

            state = await app.aget_state(config)
            if state and state.values:
                messages = state.values.get("messages", [])
                return [
                    {
                        "role": "user" if isinstance(m, HumanMessage) else "assistant",
                        "content": m.content
                    }
                    for m in messages
                ]
            return []


# ============ 单例工厂 ============

_runner_instance: Optional[BicameralRunner] = None

def get_bicameral_runner(db_uri: str = POSTGRES_URI) -> BicameralRunner:
    """获取双脑运行器单例"""
    global _runner_instance
    if _runner_instance is None:
        _runner_instance = BicameralRunner(db_uri)
    return _runner_instance


# ============ 测试入口 ============

async def test_bicameral():
    """快速测试"""
    print("=" * 60)
    print("Vulcan Brain V5.0 - LangGraph Bicameral Test (PostgreSQL)")
    print("=" * 60)

    runner = get_bicameral_runner()

    # 测试用例
    test_cases = [
        "现在几点了？",
        "写一个 Python 函数计算 1 到 100 的和",
    ]

    for query in test_cases:
        print(f"\n{'='*50}")
        print(f"Query: {query}")
        print('='*50)

        result = await runner.run(query, thread_id=f"test_{hash(query)}")
        print(f"\n📋 Final Answer:\n{result}")


if __name__ == "__main__":
    asyncio.run(test_bicameral())
