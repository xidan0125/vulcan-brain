# Vulcan Brain 配置模板
# 复制为 .env 并填入实际值

# === 基础配置 ===
APP_ENV=development  # development/staging/production
DEBUG=true

# === 安全配置 (必需!) ===
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# === 数据库 ===
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=vulcan_brain
# POSTGRES_URI=postgresql://user:pass@localhost:5432/vulcan_brain

# === API 服务 ===
API_HOST=0.0.0.0
API_PORT=8001
CORS_ORIGINS=http://localhost:3000,https://vsg-brain.com

# === 飞书配置 ===
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=

# === Acontext 配置 ===
ACONTEXT_API_URL=http://localhost:8029
ACONTEXT_CORE_URL=http://localhost:8019
ACONTEXT_BEARER_TOKEN=

# === AI 模型配置 ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:30b-a3b
GEMINI_API_KEY=
