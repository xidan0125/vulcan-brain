# ==================== Vulcan Brain .gitignore ====================
# 生成时间: 2025-11-27
# 目的: 排除环境、依赖、缓存、敏感数据

# ==================== Python ====================
venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.eggs/

# ==================== Node.js ====================
node_modules/
.next/
out/
.npm
*.tsbuildinfo

# ==================== 环境变量 (敏感!) ====================
.env
.env.local
.env.*.local
*.env

# ==================== 模型权重 (太大) ====================
model_cache/
models/
*.bin
*.safetensors
*.gguf
*.pt
*.pth
*.onnx

# ==================== 数据库 & 存储 ====================
*.db
*.sqlite
*.sqlite3
mongodb_data/

# ==================== 日志 & 缓存 ====================
*.log
logs/
.cache/
.chainlit/
*.gz
*.tar

# ==================== 编辑器 & IDE ====================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
._*

# ==================== 备份 & 临时文件 ====================
_archived_*/
*.bak
*.backup
*.tmp
*~

# ==================== 特定排除 ====================
vulcan-ui.tar.gz
twin_towers.log
api.log
api_server.log
api_mcp.log
dashboard.log
server.log
ui.log
chainlit.log
tool_server.log
